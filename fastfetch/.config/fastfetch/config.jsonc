{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    // Reports the active kitty auto theme (dark/light/no-preference), with the
    // session palette as fallback.  Fall back to a literal so a missing helper
    // can never break fastfetch.
    {
      "type": "command",
      "key": "Kitty Theme",
      "text": "$HOME/.local/bin/kitty-theme-name 2>/dev/null || printf 'Unknown\\n'"
    },
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
