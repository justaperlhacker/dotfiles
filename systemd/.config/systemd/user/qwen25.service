[Unit]
Description=llama.cpp Coding Server (Qwen2.5-Coder-14B)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/opt/llamacpp/llama-server \
    --host 127.0.0.1 \
    --port 8081 \
    --model %h/opt/models/Qwen2.5-Coder-14B-Instruct-Q4_K_M.gguf \
    --gpu-layers 24 \
    --flash-attn on \
    --cache-type-k q8_0 \
    --cache-type-v turbo2 \
    --threads 6 \
    --no-mmap \
    --ctx-size 32768 \
    --batch-size 1024 \
    --ubatch-size 1024 \
    --parallel 1 \
    --mlock \
    --n-predict -1 \
    --cont-batching

Environment=LD_LIBRARY_PATH=%h/opt/llamacpp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
