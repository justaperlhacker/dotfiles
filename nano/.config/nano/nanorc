## === Syntax coloring ===
## For all details, see 'man nanorc', section SYNTAX HIGHLIGHTING.

## To include most of the existing syntax definitions, you can do:
include "/usr/share/nano/*.nanorc"
include /usr/share/nano-syntax-highlighting/*.nanorc

## === Nord syntax overrides ===
## Recolor the common named color groups to the Nord palette for the
## most-used languages.  (Skipping 'error' and 'comment' overrides that
## would collide with the defaults already provided by each syntax.)
##
## Nord colors: Nord8 #88C0D0 (cyan), Nord9 #81A1C1 (blue),
## Nord11 #BF616A (red), Nord12 #D08770 (orange), Nord13 #EBCB8B (yellow),
## Nord14 #A3BE8C (green), Nord15 #B48EAD (purple), Nord3 #4C566A (muted).
##
## Note: nano has NO global/background option, and this build does not
## recognize a 'default' color group either -- so there is no way to set
## a text-area background for every file from nanorc.  To get a Nord0
## background everywhere, set your terminal's background color instead
## (the edit window is transparent to it when no bgcolor is forced).

## Comments: muted Nord3 across languages.
extendsyntax c color brightblack "//.*$"
extendsyntax javascript color brightblack "//.*$"
extendsyntax python color brightblack "#.*$"
extendsyntax sh color brightblack "#.*$"
extendsyntax ruby color brightblack "#.*$"
extendsyntax perl color brightblack "#.*$"
extendsyntax html color brightblack "<!--.*-->"
extendsyntax css color brightblack "/\*[^*]*\*+([^/*][^*]*\*+)*/"
extendsyntax rust color brightblack "//.*$"
extendsyntax go color brightblack "//.*$"

## Keywords: Nord8 (cyan) for language keywords.
extendsyntax c color brightcyan "\<(int|long|short|char|float|double|void|signed|unsigned|const|static|struct|union|enum|typedef|return|if|else|for|while|do|switch|case|default|break|continue|goto|sizeof|extern|register|volatile|auto|class|namespace|template|public|private|protected|virtual|new|delete|this|friend|operator|inline|override|typename|using|constexpr)\>"
extendsyntax python color brightcyan "\<(def|class|return|if|elif|else|for|while|in|not|and|or|is|None|True|False|import|from|as|with|try|except|finally|raise|lambda|pass|break|continue|del|global|nonlocal|yield)\>"
extendsyntax javascript color brightcyan "\<(function|return|var|let|const|if|else|for|while|do|switch|case|break|continue|new|typeof|instanceof|in|of|this|null|undefined|true|false|class|extends|super|import|export|try|catch|finally|throw|await|async|yield)\>"
extendsyntax sh color brightcyan "\<(if|then|else|elif|fi|for|while|do|done|case|esac|function|in|select|until|return|local|export|readonly|exit)\>"
extendsyntax ruby color brightcyan "\<(def|class|module|if|elsif|else|unless|while|until|for|in|do|end|return|break|next|redo|retry|raise|rescue|ensure|begin|case|when|then|yield|require|include|extend|nil|true|false|self|super|new)\>"
extendsyntax perl color brightcyan "\<(sub|my|our|local|use|require|if|elsif|else|unless|while|until|for|foreach|do|return|last|next|redo|cmp|ne|eq|lt|gt|le|ge|and|or|not|xor)\>"
extendsyntax rust color brightcyan "\<(fn|let|mut|const|static|if|else|match|loop|while|for|in|return|break|continue|struct|enum|impl|trait|pub|use|mod|type|where|move|ref|dyn|async|await|unsafe|extern|self|Self|true|false)\>"
extendsyntax go color brightcyan "\<(func|package|import|var|const|type|struct|interface|map|chan|if|else|for|range|switch|case|default|return|break|continue|go|defer|select|fallthrough|goto)\>"

## Strings: Nord14 (green).
extendsyntax c color brightgreen "\"(\\.|[^\"\\])*\""
extendsyntax python color brightgreen "\"(\\.|[^\"\\])*\"|'(\\.|[^'\\])*'"
extendsyntax javascript color brightgreen "\"(\\.|[^\"\\])*\"|'(\\.|[^'\\])*'|`(\\.|[^`\\])*`"
extendsyntax ruby color brightgreen "\"(\\.|[^\"\\])*\"|'(\\.|[^'\\])*'"
extendsyntax rust color brightgreen "\"(\\.|[^\"\\])*\""
extendsyntax go color brightgreen "\"(\\.|[^\"\\])*\""

## Numbers: Nord12 (orange).
extendsyntax c color brightyellow "\b(0[xX][0-9a-fA-F]+|[0-9]+(\.[0-9]*)?([eE][+-]?[0-9]+)?)"
extendsyntax python color brightyellow "\b(0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|[0-9]+(\.[0-9]*)?([eE][+-]?[0-9]+)?)"
extendsyntax javascript color brightyellow "\b(0[xX][0-9a-fA-F]+|[0-9]+(\.[0-9]*)?([eE][+-]?[0-9]+)?)"
extendsyntax rust color brightyellow "\b(0[xX][0-9a-fA-F]+|[0-9]+(\.[0-9]*)?([eE][+-]?[0-9]+)?)"
extendsyntax go color brightyellow "\b(0[xX][0-9a-fA-F]+|[0-9]+(\.[0-9]*)?([eE][+-]?[0-9]+)?)"

## Functions: Nord15 (purple) in the common C-derived families.
extendsyntax c color brightmagenta "\<[a-zA-Z_][a-zA-Z0-9_]*\>(?=\s*\()"
extendsyntax javascript color brightmagenta "\<[a-zA-Z_][a-zA-Z0-9_]*\>(?=\s*\()"
extendsyntax go color brightmagenta "\<[a-zA-Z_][a-zA-Z0-9_]*\>(?=\s*\()"

## Header/preprocessor: Nord12 (orange).
extendsyntax c color brightyellow "^\s*#\s*(include|define|undef|if|ifdef|ifndef|else|elif|endif|pragma|error|warning)"


