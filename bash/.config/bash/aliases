alias nvchad-pull="git --git-dir=\$HOME/.cache/nvchad-git/.git --work-tree=\$HOME/.dotfiles/NvChad/.config/NvChad pull"

# Neovim config switcher
alias nvchad="NVIM_APPNAME=NvChad nvim"
alias lazyvim="NVIM_APPNAME=LazyVim nvim"
alias lunarvim="~/.local/bin/LunarVim"
alias astronvim="NVIM_APPNAME=AstroVim nvim"
alias lvim="~/.local/bin/LunarVim"

# Neovim config switcher with persistent state
NVIM_STATE_FILE="${HOME}/.config/bash/.nvim-state"

_nvims_apply() {
  local config="$1"
  if [[ "$config" == "default" || "$config" == "vanilla" || -z "$config" ]]; then
    unset NVIM_APPNAME
    alias n="nvim"
  elif [[ "$config" == "LunarVim" ]]; then
    alias n="~/.local/bin/LunarVim"
  else
    export NVIM_APPNAME="${config}"
    alias n="NVIM_APPNAME=${config} nvim"
  fi
}

_nvims_save() {
  local config="$1"
  echo "$config" > "${NVIM_STATE_FILE}"
}

# Restore saved neovim selection on shell start
if [[ -f "${NVIM_STATE_FILE}" ]]; then
  _nvims_apply "$(cat "${NVIM_STATE_FILE}")"
else
  alias n='nvim'
fi

nvim_select() {
  items=("vanilla" "NvChad" "LazyVim" "LunarVim" "AstroVim")
  config=$(printf "%s\n" "${items[@]}" | fzf --prompt=" Neovim Config  " --height=~50% --layout=reverse --border --exit-0)
  if [[ -z $config ]]; then
    echo "Nothing selected"
    return 0
  fi
  _nvims_save "$config"
  _nvims_apply "$config"
  if [[ "$config" == "LunarVim" ]]; then
    ~/.local/bin/LunarVim "$@"
  elif [[ "$config" == "vanilla" || "$config" == "default" ]]; then
    nvim "$@"
  else
    NVIM_APPNAME="${config}" nvim "$@"
  fi
}

nvim_reset() {
  rm -f "${NVIM_STATE_FILE}"
  unset NVIM_APPNAME
  alias n='nvim'
  echo "Neovim config reset to default"
}

bind -x '"\C-s": nvim_select'

