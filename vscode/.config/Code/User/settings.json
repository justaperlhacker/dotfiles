{
    // disable telemetry
    "telemetry.telemetryLevel": "off",
    "window.zoomLevel": -1,
    "workbench.list.openMode": "doubleClick",
    "workbench.activityBar.location": "top",
    "workbench.colorTheme": "Rouge",
    "workbench.iconTheme": "file-icons-colourless",
    "workbench.colorCustomizations": {
        "[Fleury Theme]": {
            "sideBar.background": "#020202",
            "activityBar.background": "#020202",
            "panel.background": "#020202",
            "statusBar.background": "#020202",
            "sideBar.border": "#7a6b5a",
            "editorGroup.border": "#7a6b5a",
            "statusBar.border": "#7a6b5a",
            "titleBar.activeBackground": "#020202",
            "titleBar.inactiveBackground": "#020202",
            "titleBar.border": "#7a6b5a",
            "editorGroupHeader.tabsBackground": "#020202",
            "editorGroupHeader.noTabsBackground": "#020202",
            "tab.activeBackground": "#1E1E1E",
            "tab.inactiveBackground": "#020202",
        }
    },
    //"editor.fontFamily": "HE_TERMINAL",
    //"editor.lineHeight": 21,
    //"editor.fontFamily": "IoskeleyMono Nerd Font",
    //"editor.fontFamily": "JetBrainsMono Nerd Font",
    //"editor.fontFamily": "Fira Code",
    //"editor.fontFamily": "Liberation Mono",
    //"editor.fontFamily": "Monaspace Radon NF", //italic
    //"editor.fontFamily": "Monaspace neon NF",
    //"editor.fontFamily": "Monaspace Argon NF",      
    //"editor.lineHeight": 0,
    "editor.fontWeight": "600",
    "editor.fontSize": 16,
    "editor.fontLigatures": false,
    "editor.cursorStyle": "line",
    "editor.minimap.enabled": false,
    "git.enabled": false,
    "github.copilot.enable": {
        "*": false,
    },
    "makefile.configureOnOpen": true,
    "chat.viewSessions.orientation": "stacked",
    "files.watcherExclude": {
        ".git/objects/**": true,
        ".git/subtree-cache/**": true,
        ".hg/store/**": true,
        "*/.git/objects/**": true,
        "*/.git/subtree-cache/**": true,
        "*/.hg/store/**": true,
        "**/__pycache__/**": true,
        "**/*.py[cod]": true
    },
    "files.exclude": {
        "**/.vscode": true,
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/__pycache__/**": true,
        "**/*.py[cod]": true
    },
    "files.associations": {
        "**/.bashrc": "shellscript",
        "**/.bash_aliases": "shellscript",
        "**/.inputrc": "properties",
        "**/.Xresources": "properties",
        "**/.Xresources.d/*": "properties",
        "config": "properties",
        "*.toml": "properties"
    }
}