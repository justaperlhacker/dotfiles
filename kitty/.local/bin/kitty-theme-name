#!/bin/sh
# Print the human-readable name of the kitty theme currently in effect.
#
# kitty applies colours in this order (later wins):
#   - kitty.conf and its includes
#   - <scheme>-theme.auto.conf for the OS colour scheme, if present.  These
#     files override every other colour source, including --override.
#
# So ask the auto theme first, then the session palette (theme-session.d/
# active.conf, written by i3-theme-sync / dms-theme-sync.sh), then the static
# current-theme.conf, then kitty.conf's own include chain.  This runs from
# fastfetch, including non-interactive contexts, so it must never hang and
# never fail.

confdir=${KITTY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/kitty}

name_from() {
    [ -r "$1" ] || return 0
    sed -n 's/^##[[:space:]]*name:[[:space:]]*//p' "$1" 2>/dev/null |
        head -n 1 |
        tr -d '\r'
}

# Last named file in kitty.conf's include chain.  Used when no auto theme
# exists for the current scheme: kitty then falls back to the normal config
# includes, so mirror which of them wins (later includes override earlier).
name_from_includes() {
    [ -r "$confdir/kitty.conf" ] || return 0
    sed -n 's/^[[:space:]]*\(glob\)\{0,1\}include[[:space:]]\{1,\}//p' "$confdir/kitty.conf" |
        while IFS= read -r inc; do
            case $inc in
                ''|'#'*) continue ;;
                /*) target=$inc ;;
                *) target=$confdir/$inc ;;
            esac
            for f in $target; do
                name_from "$f"
            done
        done |
        tail -n 1
}

run_timeout() {
    if command -v timeout >/dev/null 2>&1; then
        timeout 2 "$@"
    else
        "$@"
    fi
}

# light | dark | no-preference.  Prefer the XDG portal: that is what kitty
# itself reads on Wayland.  Fall back to gsettings, which the desktop shells
# here also keep in sync.
os_scheme() {
    value=
    if command -v gdbus >/dev/null 2>&1; then
        value=$(run_timeout gdbus call --session \
            --dest org.freedesktop.portal.Desktop \
            --object-path /org/freedesktop/portal/desktop \
            --method org.freedesktop.portal.Settings.Read \
            org.freedesktop.appearance color-scheme 2>/dev/null) || value=
    fi
    # 0 = no preference, 1 = prefer dark, 2 = prefer light
    case $value in
        *"uint32 1"*) printf '%s\n' dark; return 0 ;;
        *"uint32 2"*) printf '%s\n' light; return 0 ;;
        *"uint32 0"*) printf '%s\n' no-preference; return 0 ;;
    esac

    value=
    if command -v gsettings >/dev/null 2>&1; then
        value=$(run_timeout gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null |
            tr -d "'\"")
    fi
    case $value in
        prefer-dark)  printf '%s\n' dark ;;
        prefer-light) printf '%s\n' light ;;
        *)            printf '%s\n' no-preference ;;
    esac
}

# Overridable for testing (and for unusual launchers that already know the
# scheme): KITTY_THEME_SCHEME=dark|light|no-preference
scheme=${KITTY_THEME_SCHEME:-$(os_scheme)}
case $scheme in
    dark|light|no-preference) ;;
    *) scheme=no-preference ;;
esac

auto=$confdir/$scheme-theme.auto.conf
if [ -r "$auto" ]; then
    name=$(name_from "$auto")
    if [ -z "$name" ]; then
        case $scheme in
            dark)  name='Kitty auto (dark)' ;;
            light) name='Kitty auto (light)' ;;
            *)     name='Kitty auto (no preference)' ;;
        esac
    fi
else
    # No auto theme for this scheme: kitty uses the normal config includes.
    # Prefer the known session/default files, then walk kitty.conf itself so
    # custom include layouts keep working too.
    name=$(name_from "$confdir/theme-session.d/active.conf")
    [ -n "$name" ] || name=$(name_from "$confdir/current-theme.conf")
    [ -n "$name" ] || name=$(name_from_includes)
fi

[ -n "$name" ] || name='Unknown'

printf '%s\n' "$name"
