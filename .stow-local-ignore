# ~./dotfiles/.stow.local.ignore: Files to be ignored by gnu 'stow'
#
# Comments and blank lines are allowed.
#
# See 'info stow' section "4 Ignore Lists" for more information

RCS
.+,v

CVS
\.\#.+       # CVS conflict files / emacs lock files
\.cvsignore

\.svn
_darcs
\.hg

\.git
\.gitignore

.+~          # emacs backup files
\#.*\#       # emacs autosave files

^/README.*
^/LICENSE.*
^/COPYING

# Keep *.wants symlink dirs out of stow (managed locally by systemctl enable)
\.config/systemd/user/[^/]+\.wants

# DankMaterialShell transient / managed files
^DankMaterialShell/.config/DankMaterialShell/.changelog-.*
^DankMaterialShell/.config/DankMaterialShell/.firstlaunch
^DankMaterialShell/.config/DankMaterialShell/firefox\.css
^DankMaterialShell/.config/DankMaterialShell/plugins/

# Midnight Commander runtime state (rewritten each session) — never stow
#^mc/.config/mc/ini
#^mc/.config/mc/panels\.ini

# pi runtime / downloaded state
^pi/.pi/agent/npm
^pi/.pi/agent/sessions
