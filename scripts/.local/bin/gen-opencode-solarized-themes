def osaka_hues(dark):
    if dark:
        hues = copy.deepcopy(OSAKA_ACCENT_SCALES)
        hues["gray"] = copy.deepcopy(OSAKA_GRAY_DARK)
    else:
        hues = {name: invert(values) for name, values in OSAKA_ACCENT_SCALES.items()}
        hues["gray"] = copy.deepcopy(OSAKA_GRAY_LIGHT)
    hues["accent"] = "$hue.green"
    hues["interactive"] = "$hue.green"
    hues["neutral"] = "$hue.gray"
    return hues


