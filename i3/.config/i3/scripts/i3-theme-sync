#!/usr/bin/env perl
# Keep the i3 session in sync with KDE's dark/light schedule.
#
# KDE's `knighttimed` exposes the same sunrise/sunset schedule that Plasma's
# Night Light and automatic look-and-feel use.  i3 is X11, but the D-Bus
# service is session-independent, so we can read the schedule and apply it to
# i3, GTK, Qt/KDE, rofi/dunst and the terminals.
#
# The script is started from i3's autostart with `exec_always` so it also
# comes back after an i3 restart; a lock keeps reloads from starting a second
# copy.  It polls the schedule and only does work when the mode changes.
use v5.36;
use strict;
use warnings;

use Fcntl qw(:flock F_SETFD FD_CLOEXEC);
use File::Basename qw(dirname);
use File::Copy qw(copy);
use File::Path qw(make_path);
use Time::HiRes qw(sleep);

my $HOME = $ENV{HOME} // die "i3-theme-sync: HOME is not set\n";

my $I3_DIR       = "$HOME/.config/i3";
my $SWITCH_THEME = "$I3_DIR/scripts/switch-theme";
my $THEME_CONFIG = "$I3_DIR/theme-sync.conf";
my $STATE_DIR    = ( $ENV{XDG_STATE_HOME} // "$HOME/.local/state" ) . '/i3-theme-sync';
my $STATE_FILE   = "$STATE_DIR/mode";
my $LOG_FILE     = "$STATE_DIR/log";
my $LOCK_FILE    = $ENV{XDG_RUNTIME_DIR}
  ? "$ENV{XDG_RUNTIME_DIR}/i3-theme-sync.lock"
  : "/tmp/i3-theme-sync-$<.lock";

my $DARK_THEME;
my $LIGHT_THEME;
my $theme_config_last = '';

sub load_theme_config {
    my $content = '';
    if ( open my $fh, '<', $THEME_CONFIG ) {
        local $/;
        $content = <$fh>;
        close $fh;
    }

    my $changed = $content ne $theme_config_last;
    $theme_config_last = $content;

    my %config;
    for my $line ( split /\n/, $content ) {
        my ( $key, $value ) = $line =~ /^\s*([A-Za-z_]+)\s*=\s*(.*?)\s*$/
          or next;
        $config{ uc $key } = $value;
    }

    $DARK_THEME  = $ENV{I3_DARK_THEME}  // $config{DARK}  // 'github-dark';
    $LIGHT_THEME = $ENV{I3_LIGHT_THEME} // $config{LIGHT} // 'github-light';
    return $changed;
}

load_theme_config();

my $GHOSTTY_SESSION  = "$HOME/.config/ghostty/theme-session.conf";
my $KITTY_SESSION_DIR = "$HOME/.config/kitty/theme-session.d";
my $KITTY_SESSION     = "$KITTY_SESSION_DIR/active.conf";

my $POLL_SECONDS = 60;
my $schedule_failed_logged = 0;

make_path($STATE_DIR);

sub logmsg {
    my ($msg) = @_;
    my @t = localtime;
    my $ts = sprintf '%04d-%02d-%02d %02d:%02d:%02d',
      $t[5] + 1900, $t[4] + 1, $t[3], $t[2], $t[1], $t[0];
    if ( open my $fh, '>>', $LOG_FILE ) {
        print $fh "$ts $msg\n";
        close $fh;
    }
    print STDERR "i3-theme-sync: $msg\n" if $ENV{I3_THEME_SYNC_VERBOSE};
}

sub command_exists {
    my ($name) = @_;
    for my $dir ( split /:/, ( $ENV{PATH} // '' ) ) {
        return 1 if -x "$dir/$name";
    }
    return 0;
}

sub run_quiet {
    my (@cmd) = @_;
    my $pid = fork // return 1;
    if ( $pid == 0 ) {
        open STDIN,  '<', '/dev/null';
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
        exec(@cmd);
        exit 1;
    }
    waitpid( $pid, 0 );
    return $? >> 8;
}

sub read_state {
    return undef unless -r $STATE_FILE;
    open my $fh, '<', $STATE_FILE or return undef;
    my $mode = <$fh>;
    close $fh;
    return undef unless defined $mode;
    chomp $mode;
    return $mode eq 'dark' || $mode eq 'light' ? $mode : undef;
}

sub write_state {
    my ($mode) = @_;
    open my $fh, '>', $STATE_FILE or return;
    print $fh "$mode\n";
    close $fh;
}

sub time_to_minutes {
    my ($value) = @_;
    return undef unless defined $value;
    my ( $h, $m ) = $value =~ /^(\d{1,2}):(\d{2})/ or return undef;
    return $h * 60 + $m;
}

# Fallback matching knighttimed's own timed scheduler.  This keeps i3 usable
# if the D-Bus service is not activatable (for example before a Plasma login
# has ever stored a location).
sub fallback_mode {
    my $sunrise = '06:00';
    my $sunset  = '18:00';
    my $rc      = "$HOME/.config/knighttimerc";

    if ( open my $fh, '<', $rc ) {
        local $/;
        my $content = <$fh>;
        close $fh;
        if ( defined $content && $content =~ /^\[Times\](.*?)(?=^\[|\z)/ms ) {
            my $times = $1;
            ($sunrise) = $times =~ /^SunriseStart\s*=\s*(\d{1,2}:\d{2}(?::\d{2})?)/m
              if $times =~ /^SunriseStart\s*=/m;
            ($sunset) = $times =~ /^SunsetStart\s*=\s*(\d{1,2}:\d{2}(?::\d{2})?)/m
              if $times =~ /^SunsetStart\s*=/m;
        }
    }

    my $rise = time_to_minutes($sunrise) // ( 6 * 60 );
    my $set  = time_to_minutes($sunset)  // ( 18 * 60 );
    my ( undef, undef, undef, undef, undef, $hour, $min ) = localtime;
    my $now = $hour * 60 + $min;
    return ( $now < $rise || $now >= $set ) ? 'dark' : 'light';
}

sub mode_from_schedule {
    my ($cycles) = @_;
    return undef unless $cycles && @$cycles;

    my $now = int( time() * 1000 );
    my ($cycle) = sort { abs( $a->[0] - $now ) <=> abs( $b->[0] - $now ) } @$cycles;
    return undef unless $cycle;

    my ( undef, $morning_start, undef, $evening_start, undef ) = @$cycle;
    return ( $now >= $evening_start || $now < $morning_start ) ? 'dark' : 'light';
}

sub schedule_from_knighttime {
    return undef unless command_exists('gdbus');

    my $call = q{gdbus call --session }
      . q{--dest org.kde.NightTime }
      . q{--object-path /org/kde/NightTime/Manager }
      . q{--method org.kde.NightTime.Manager.Subscribe '{}' 2>/dev/null};
    my $out = qx{$call};
    return undef if $? != 0 || !defined $out || $out eq '';

    my ($cookie) = $out =~ /'Cookie':\s*<uint32\s+(\d+)>/;
    my @numbers = $out =~ /\b(\d{13})\b/g;
    return undef unless @numbers && @numbers % 5 == 0;

    if ( defined $cookie ) {
        my $unsubscribe = q{gdbus call --session }
          . q{--dest org.kde.NightTime }
          . q{--object-path /org/kde/NightTime/Manager }
          . q{--method org.kde.NightTime.Manager.Unsubscribe }
          . $cookie
          . q{ >/dev/null 2>&1};
        qx{$unsubscribe};
    }

    my @cycles;
    while (@numbers) {
        my @cycle = splice @numbers, 0, 5;
        push @cycles, \@cycle;
    }
    return \@cycles;
}

sub current_mode {
    my $cycles = schedule_from_knighttime();
    if ($cycles) {
        $schedule_failed_logged = 0;
        my $mode = mode_from_schedule($cycles);
        return $mode if defined $mode;
    }

    if ( !$schedule_failed_logged ) {
        logmsg('KDE NightTime schedule unavailable; using knighttimerc times');
        $schedule_failed_logged = 1;
    }
    return fallback_mode();
}

# knighttimed only uses its cached solar location if a GeoClue source can be
# created.  i3 has no desktop-shell GeoClue agent, so start the demo agent,
# wake the system service, then restart knighttimed so it reconfigures with
# the solar scheduler instead of the 06:00/18:00 timed fallback.
sub warm_geoclue {
    return unless command_exists('busctl');

    my $agent = '/usr/lib/geoclue-2.0/demos/agent';
    if ( -x $agent && run_quiet( 'pgrep', '-f', $agent ) != 0 ) {
        my $pid = fork // 0;
        if ( $pid == 0 ) {
            open STDIN,  '<', '/dev/null';
            open STDOUT, '>', '/dev/null';
            open STDERR, '>', '/dev/null';
            exec($agent);
            exit 1;
        }
    }

    # Trigger D-Bus activation of the system GeoClue service without needing
    # a systemctl authorization prompt.
    my $pid = fork // 0;
    if ( $pid == 0 ) {
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
        exec(
            'busctl', '--system', 'call',
            'org.freedesktop.GeoClue2',
            '/org/freedesktop/GeoClue2/Manager',
            'org.freedesktop.DBus.Peer', 'Ping'
        );
        exit 1;
    }

    my $ready = 0;
    for ( 1 .. 30 ) {
        my $system_up = run_quiet( 'busctl', '--system', 'status', 'org.freedesktop.GeoClue2' ) == 0;
        my $agent_up  = run_quiet( 'busctl', '--user', 'status', 'org.freedesktop.GeoClue2.DemoAgent' ) == 0;
        if ( $system_up && $agent_up ) {
            $ready = 1;
            last;
        }
        sleep 1;
    }

    run_quiet( 'systemctl', '--user', 'restart', 'plasma-knighttimed.service' );
    logmsg(
        $ready
        ? 'warmed GeoClue; knighttimed restarted for the solar schedule'
        : 'GeoClue did not come up; knighttimed restarted (timed fallback may apply)'
    );
}

sub set_ini_key {
    my ( $file, $key, $value ) = @_;
    return unless -f $file;

    open my $in, '<', $file or return;
    my @lines = <$in>;
    close $in;
    chomp @lines;

    my $found    = 0;
    my $settings = 0;
    my $insert_at;
    for my $i ( 0 .. $#lines ) {
        my $line = $lines[$i];
        if ( $line =~ /^\[/ ) {
            $settings = $line eq '[Settings]';
            $insert_at = $i + 1 if $settings && !defined $insert_at;
        }
        if ( $settings && $line =~ /^\Q$key\E=/ ) {
            $lines[$i] = "$key=$value";
            $found = 1;
        }
    }

    if ( !$found ) {
        if ( defined $insert_at ) {
            splice @lines, $insert_at, 0, "$key=$value";
        }
        else {
            push @lines, '[Settings]', "$key=$value";
        }
    }

    open my $out, '>', $file or return;
    print $out map { "$_\n" } @lines;
    close $out;
}

sub set_gtk_theme {
    my ($dark) = @_;
    my $color_scheme = $dark ? 'prefer-dark' : 'prefer-light';
    my $gtk_theme    = $dark ? 'Breeze-Dark' : 'Breeze';
    my $icon_theme   = $dark ? 'breeze-dark' : 'breeze';

    system( 'gsettings', 'set', 'org.gnome.desktop.interface', 'color-scheme', $color_scheme );
    system( 'gsettings', 'set', 'org.gnome.desktop.interface', 'gtk-theme',    $gtk_theme );
    system( 'gsettings', 'set', 'org.gnome.desktop.interface', 'icon-theme',   $icon_theme );

    for my $file ( "$HOME/.config/gtk-3.0/settings.ini", "$HOME/.config/gtk-4.0/settings.ini" ) {
        next unless -f $file;
        set_ini_key( $file, 'gtk-application-prefer-dark-theme', 'false' );
        set_ini_key( $file, 'gtk-theme-name', $gtk_theme );
        set_ini_key( $file, 'gtk-icon-theme-name', $icon_theme );
    }

    # niri's dms-theme-sync owns the DMS-generated palette; while i3 is in
    # charge, let the real Breeze GTK theme provide the colors.  The marker is
    # recognised by dms-theme-sync, which restores dank-colors.css in niri.
    my $marker = "/* i3-theme-sync: use the Breeze GTK theme; niri restores the DMS palette */\n";
    for my $file ( "$HOME/.config/gtk-3.0/gtk.css", "$HOME/.config/gtk-4.0/gtk.css" ) {
        next unless -f $file;
        open my $in, '<', $file or next;
        local $/;
        my $content = <$in>;
        close $in;
        next unless defined $content;
        next if $content =~ /i3-theme-sync/;
        next unless $content =~ /dank-colors\.css|Generated with Matugen|colors\.css/;

        my $backup = "$file.i3-sync-backup";
        copy( $file, $backup ) unless -e $backup;
        open my $out, '>', $file or next;
        print $out $marker;
        close $out;
    }
}

sub ensure_kdeglobals {
    my $live = "$HOME/.config/kdeglobals";
    return if !-l $live && -e $live;

    if ( -l $live ) {
        my $tmp = "$live.i3-sync";
        if ( copy( $live, $tmp ) ) {
            rename $tmp, $live
              or logmsg("could not replace the kdeglobals symlink: $!");
        }
        return;
    }

    my $dotfiles = $ENV{DOTFILES} // "$HOME/.dotfiles";
    my $base     = "$dotfiles/kde/.config/kdeglobals";
    copy( $base, $live ) if -r $base;
}

sub set_kde_theme {
    my ($dark) = @_;
    ensure_kdeglobals();

    my $scheme = $dark ? 'BreezeDark' : 'BreezeLight';
    if ( command_exists('plasma-apply-colorscheme') ) {
        system( 'plasma-apply-colorscheme', $scheme );
    }

    if ( command_exists('kwriteconfig6') ) {
        my $lnf = $dark ? 'org.kde.breezedark.desktop' : 'org.kde.breeze.desktop';
        my $icon = $dark ? 'breeze-dark' : 'breeze';
        my $gtk  = $dark ? 'Breeze-Dark' : 'Breeze';
        system( 'kwriteconfig6', '--file', 'kdeglobals', '--group', 'General', '--key', 'ColorScheme',      $scheme );
        system( 'kwriteconfig6', '--file', 'kdeglobals', '--group', 'KDE',   '--key', 'LookAndFeelPackage', $lnf );
        system( 'kwriteconfig6', '--file', 'kdeglobals', '--group', 'Icons', '--key', 'ThemeName',         $icon );
        system( 'kwriteconfig6', '--file', 'kdeglobals', '--group', 'GTK',   '--key', 'ThemeName',         $gtk );
    }
}

# Prefer the palette's own "## name:" header (e.g. "GitHub Dark"), but fall
# back to the theme id used on the command line / in theme-sync.conf.
sub kitty_theme_name {
    my ($source, $fallback) = @_;

    if ( open my $fh, '<', $source ) {
        while ( my $line = <$fh> ) {
            if ( $line =~ /^##[ \t]*name:[ \t]*(.+?)[ \t]*$/ ) {
                close $fh;
                return $1;
            }
        }
        close $fh;
    }
    return $fallback;
}

sub set_terminal_theme {
    my ($theme) = @_;

    my $kitty_source = "$HOME/.config/kitty/$theme.conf";
    make_path($KITTY_SESSION_DIR);
    if ( -r $kitty_source ) {
        my $name = kitty_theme_name( $kitty_source, $theme );
        my $tmp  = "$KITTY_SESSION.tmp.$$";

        # Write to a temporary file first so a failed write (disk full,
        # permissions, killed mid-write) leaves the previous session file
        # intact instead of truncating it.
        if ( open my $in, '<', $kitty_source ) {
            if ( open my $out, '>', $tmp ) {
                my $ok = print {$out} "## name: $name\n";

                while ( my $line = <$in> ) {
                    # Drop any existing header so the name can't appear twice.
                    next if $line =~ /^##[ \t]*name:/;
                    $ok &&= print {$out} $line;
                }

                # A short read (e.g. the file vanished) must not replace a
                # good session file with a truncated palette.
                $ok &&= eof $in;
                my $closed = close $out;
                $ok &&= $closed;
                close $in;

                if ( $ok && -s $tmp ) {
                    rename( $tmp, $KITTY_SESSION )
                      or do {
                        logmsg("could not replace $KITTY_SESSION: $!");
                        unlink $tmp;
                      };
                }
                else {
                    logmsg("could not write complete $tmp; keeping existing $KITTY_SESSION");
                    unlink $tmp;
                }
            }
            else {
                logmsg("could not write $tmp: $!");
                close $in;
            }
        }
        else {
            logmsg("could not read kitty palette $kitty_source: $!");
        }
    }
    else {
        logmsg("missing kitty palette $kitty_source");
    }

    my $ghostty_theme = "$HOME/.config/ghostty/themes/$theme";
    if ( -f $ghostty_theme ) {
        if ( open my $fh, '>', $GHOSTTY_SESSION ) {
            print $fh "theme = $theme\n";
            close $fh;
        }
        else {
            logmsg("could not write $GHOSTTY_SESSION: $!");
        }
    }
    else {
        logmsg("missing Ghostty theme $ghostty_theme");
    }

    system( 'pkill', '-USR1', '-x', 'kitty' );
    system( 'pkill', '-USR2', '-x', 'ghostty' );
}

sub read_theme_mode {
    my ($theme) = @_;
    my $file = "$I3_DIR/themes/$theme/mode";
    return undef unless -r $file;

    open my $fh, '<', $file or return undef;
    my $mode = <$fh>;
    close $fh;
    return undef unless defined $mode;
    chomp $mode;
    return $mode =~ /^(dark|light)$/ ? $mode : undef;
}

# Apply a single theme manually (from the fzf picker).  This does not update
# the scheduled-mode state, so the automatic sync resumes at the next
# sunrise/sunset transition.
sub apply_theme_only {
    my ($theme) = @_;
    my $dir = "$I3_DIR/themes/$theme";
    unless ( -d $dir && -e "$dir/i3.conf" ) {
        warn "i3-theme-sync: unknown theme '$theme'\n";
        exit 2;
    }

    if ( -x $SWITCH_THEME ) {
        system( $SWITCH_THEME, $theme ) == 0
          or logmsg("switch-theme $theme failed");
    }
    else {
        logmsg("missing $SWITCH_THEME");
    }

    set_terminal_theme($theme);

    my $theme_mode = read_theme_mode($theme);
    if ($theme_mode) {
        my $dark = $theme_mode eq 'dark';
        set_gtk_theme($dark);
        set_kde_theme($dark);
        system( 'systemctl', '--user', 'try-restart', 'xdg-desktop-portal-gtk.service' );
        system( 'systemctl', '--user', 'try-restart', 'plasma-xdg-desktop-portal-kde.service' );
        logmsg("manually applied theme $theme (apps: $theme_mode)");
    }
    else {
        logmsg("manually applied theme $theme (apps unchanged)");
    }
}

sub apply_mode {
    my ( $mode, $force ) = @_;
    my $last = read_state();
    return if !$force && defined $last && $last eq $mode;

    logmsg("switching to $mode mode");

    my $theme = $mode eq 'dark' ? $DARK_THEME : $LIGHT_THEME;
    if ( -x $SWITCH_THEME ) {
        system( $SWITCH_THEME, $theme ) == 0
          or logmsg("switch-theme $theme failed");
    }
    else {
        logmsg("missing $SWITCH_THEME");
    }

    my $dark = $mode eq 'dark';
    set_gtk_theme($dark);
    set_kde_theme($dark);
    system( 'systemctl', '--user', 'try-restart', 'xdg-desktop-portal-gtk.service' );
    system( 'systemctl', '--user', 'try-restart', 'plasma-xdg-desktop-portal-kde.service' );
    set_terminal_theme($theme);

    write_state($mode);
    logmsg("applied $mode mode");
}

sub i3_running {
    my $out = qx{i3-msg -t get_version 2>/dev/null};
    return defined $out && $out =~ /"major"/;
}

sub usage {
    say "usage: i3-theme-sync [--once] [--get-mode] [--mode dark|light] [--theme NAME] [--help]";
}

my $once     = grep { $_ eq '--once' } @ARGV;
my $get_mode = grep { $_ eq '--get-mode' } @ARGV;
my $help     = grep { $_ eq '--help' || $_ eq '-h' } @ARGV;
my $forced_mode;
my $forced_theme;
for my $i ( 0 .. $#ARGV ) {
    if ( $ARGV[$i] eq '--mode' ) {
        $forced_mode = $ARGV[ $i + 1 ];
    }
    elsif ( $ARGV[$i] eq '--theme' ) {
        $forced_theme = $ARGV[ $i + 1 ];
    }
}

if ($help) {
    usage();
    exit 0;
}

if ( defined $forced_mode && $forced_mode !~ /^(dark|light)$/ ) {
    warn "i3-theme-sync: --mode must be dark or light\n";
    exit 2;
}

if ( defined $forced_theme && defined $forced_mode ) {
    warn "i3-theme-sync: --theme and --mode cannot be combined\n";
    exit 2;
}

if ( defined $forced_theme ) {
    apply_theme_only($forced_theme);
    exit 0;
}

if ($get_mode) {
    my $mode = $forced_mode // current_mode();
    say $mode;
    exit 0;
}

my $lock_fh;
if ( !$forced_mode ) {
    open $lock_fh, '>', $LOCK_FILE or do {
        warn "i3-theme-sync: cannot open $LOCK_FILE: $!\n";
        exit 1;
    };
    if ( !flock( $lock_fh, LOCK_EX | LOCK_NB ) ) {
        # exec_always re-runs us after every reload/restart; the existing
        # daemon owns the lock, so this copy can exit silently.
        exit 0;
    }
    # The GeoClue agent is a long-lived child; do not let it inherit the lock
    # or it would keep the lock after this daemon exits/restarts.
    fcntl( $lock_fh, F_SETFD, FD_CLOEXEC );
}

if ($forced_mode) {
    apply_mode( $forced_mode, 1 );
    exit 0;
}

# Refuse to run outside an i3 session.  The autostart entry is the only
# launcher, but this also protects against a manual start from niri/Plasma.
my $i3_ok = 0;
for ( 1 .. 50 ) {
    if ( i3_running() ) {
        $i3_ok = 1;
        last;
    }
    sleep 0.2;
}
unless ($i3_ok) {
    logmsg('i3 is not running; exiting instead of changing another session');
    exit 0;
}

# Do this before the first schedule query so knighttimed starts with the
# cached solar location rather than the timed fallback.
warm_geoclue();
my $mode = current_mode();

apply_mode( $mode, 1 );
exit 0 if $once;

while (1) {
    sleep $POLL_SECONDS;
    my $config_changed = load_theme_config();
    my $next = current_mode();
    next unless defined $next;
    apply_mode( $next, $config_changed ? 1 : 0 );
}
