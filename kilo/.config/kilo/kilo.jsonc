      "coredumpctl *": "allow",
      "strings *": "allow",
      "zstd *": "allow",
      "python3 *": "allow",
      "env *": "allow",
      "hostname *": "allow",
      "chmod *": "allow",
      "perl *": "allow",
      "/usr/bin/perl *": "allow",
      "bash *": "allow",
      "curl *": "allow",
      "read *": "allow",
      "continue *": "allow",
      "sed *": "allow",
      "git log *": "allow",
      "git show *": "allow",
