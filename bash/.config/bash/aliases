# emacs
alias em='emacs -nw'
alias doomemacs="emacs --with-profile doom --name Doom-Emacs"
alias spacemacs="emacs --with-profile spacemacs --name Spacemacs"
alias gnuemacs="emacs --with-profile vanilla"

# Emacs profile switcher with persistent state
EMACS_STATE_FILE="${HOME}/.config/bash/.emacs-state"

_emacs_apply() {
  local profile="$1"
  if [[ "$profile" == "default" || -z "$profile" ]]; then
    alias em='emacs -nw'
    unalias emacs
  else
    alias em="emacs -nw --with-profile ${profile}"
    alias emacs="emacs --with-profile ${profile}"
  fi
}

_emacs_save() {
  local profile="$1"
  echo "$profile" > "${EMACS_STATE_FILE}"
}

# Restore saved emacs profile on shell start
if [[ -f "${EMACS_STATE_FILE}" ]]; then
  _emacs_apply "$(cat "${EMACS_STATE_FILE}")"
else
  alias em='emacs -nw --with-profile vanilla'
  alias emacs='emacs --with-profile vanilla'
fi

emacs_select() {
  items=("default" "doom" "spacemacs" "vanilla")
  profile=$(printf "%s\n" "${items[@]}" | fzf --prompt=" Emacs Profile  " --height=~50% --layout=reverse --border --exit-0)
  if [[ -z $profile ]]; then
    echo "Nothing selected"
    return 0
  fi
  _emacs_save "$profile"
  _emacs_apply "$profile"
  echo "Emacs profile set to: ${profile}"
}

emacs_reset() {
  rm -f "${EMACS_STATE_FILE}"
  alias em='emacs -nw'
  unalias emacs
  echo "Emacs profile reset to default"
}

