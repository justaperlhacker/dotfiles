    // File / search behavior
    "files.watcherExclude": {
        ".git/objects/**": true,
        ".git/subtree-cache/**": true,
        ".hg/store/**": true,
        "*/.git/objects/**": true,
        "*/.git/subtree-cache/**": true,
        "*/.hg/store/**": true,
        "**/__pycache__/**": true,
        "**/*.py[cod]": true,
        "**/blib": true,
        "**/inc": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/__pycache__/**": true,
        "**/*.py[cod]": true,
        "**/blib": true,
        "**/inc": true
    },
    "files.associations": {
        "**/.bashrc": "shellscript",
        "**/.bash_aliases": "shellscript",
        "**/.inputrc": "properties",
        "**/.Xresources": "properties",
        "**/.Xresources.d/*": "properties",
        "config": "properties",
        "*.toml": "properties",
        "*.pod": "perl"
    },

