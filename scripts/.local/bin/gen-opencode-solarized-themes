def hc_hues(dark):
    hues = {name: scale(color, dark) for name, color in HC_ACCENTS.items()}
    hues["gray"] = copy.deepcopy(HC_GRAY_DARK if dark else HC_GRAY_LIGHT)
    hues["accent"] = "$hue.green"
    hues["interactive"] = "$hue.green"
    hues["neutral"] = "$hue.gray"
    return hues


