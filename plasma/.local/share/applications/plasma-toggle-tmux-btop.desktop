[Desktop Entry]
Type=Application
Name=btop Scratchpad
GenericName=Resource monitor scratchpad
Comment=Toggle the btop tmux scratchpad (SUPER+F11)
Exec=/usr/bin/systemctl --user start plasma-toggle-tmux@btop.service
Icon=kitty
Terminal=false
StartupNotify=false
StartupWMClass=tmux-btop
Categories=System;Monitor;
Keywords=btop;tmux;scratchpad;terminal;
