[Desktop Entry]
Type=Application
Name=opencode Scratchpad
GenericName=AI coding scratchpad
Comment=Toggle the opencode tmux scratchpad (SUPER+F9)
Exec=/usr/bin/systemctl --user start plasma-toggle-tmux@opencode.service
Icon=kitty
Terminal=false
StartupNotify=false
StartupWMClass=tmux-opencode
Categories=Development;Utility;
Keywords=opencode;tmux;scratchpad;terminal;
