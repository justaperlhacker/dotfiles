// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "ui_font_size": 14,
  "buffer_font_size": 16,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 13, 
  },
  "theme": {
    "mode": "system",
    "light": "DankShell Light",
    "dark": "Kimbie Dark",
  },
  "buffer_font_family": "HE_TERMINAL Nerd Font",
  "buffer_font_fallbacks": ["JetBrainsMono Nerd Font", "BerkeleyMono Nerd Font"],
  //"buffer_font_weight": 400,
  "disable_ai": true,
  "auto_indent": "syntax_aware",
  "auto_install_extensions": {
    "kitty": true,
    "perl": true,
  },
  "file_types": {
    "Kitty": ["kitty.conf", "**/kitty/**/*.conf"],
    // Perl + Raku approximation (no real Raku language in Zed yet).
    // Raku files get Perl highlighting until ~/Projects/zed-raku lands.
    "Perl": [
      "**/*.pl", "**/*.pm", "**/*.t", "**/*.PL", "**/*.pod",
      "**/*.raku", "**/*.rakumod", "**/*.rakutest", "**/*.rakudoc",
      "**/*.p6", "**/*.pl6", "**/*.pm6", "**/*.t6", "**/*.pod6", "**/*.nqp",
    ],
  },
}
