      "sleep *": "allow",
      "fuser *": "allow",
      "systemd-run *": "allow",
      "git clone *": "allow",
      "makepkg *": "allow",
      "flatpak *": "allow",
      "systemctl list-unit-files *": "allow",
      "git pull *": "allow",
      "cd *": "allow",
      "cargo --version *": "allow",
