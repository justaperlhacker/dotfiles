{
    // General / UI
    // disable telemetry
    "update.mode": "none",
    "telemetry.telemetryLevel": "off",
    "telemetry.enableCrashReporter": false,
    "telemetry.enableDiagnostics": false,
    "telemetry.feedback.enabled": false,
    "telemetry.editStats.enabled": false,
    "redhat.telemetry.enabled": false,
    "extensions.ignoreRecommendations": true,
    "workbench.list.openMode": "doubleClick",
    "workbench.activityBar.location": "top",
    "workbench.colorTheme": "Fleury Theme",
    "workbench.iconTheme": "file-icons-colourless",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "git.enabled": false,
    "makefile.configureOnOpen": true,
    "chat.viewSessions.orientation": "stacked",
    "github.copilot.enable": {
        "*": false
    },
    // zoom level
    "window.zoomLevel": -1,

    // trusted domains
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    
    // Theme customization
    "workbench.colorCustomizations": {
        "[Fleury Theme]": {
            "sideBar.background": "#020202",
            "activityBar.background": "#020202",
            "panel.background": "#020202",
            "statusBar.background": "#020202",
            "editorGroup.border": "#7a6b5a",
            "statusBar.border": "#7a6b5a",
            "titleBar.activeBackground": "#020202",
            "titleBar.inactiveBackground": "#020202",
            "titleBar.border": "#7a6b5a",
            "editorGroupHeader.tabsBackground": "#020202",
            "editorGroupHeader.noTabsBackground": "#020202",
            "tab.activeBackground": "#1E1E1E",
            "tab.inactiveBackground": "#020202"
        },
        "[Rouge]": {
            "tab.activeBackground": "#1b1b1b",
            "tab.activeForeground": "#f3e9da",
            "tab.unfocusedActiveBackground": "#171717",
            "editorGroup.border": "#7a6b5a",
            "sideBar.border": "#7a6b5a"
        }
    },

    // Editor
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontWeight": "600",
    // at zoom -1 fontsize 17 matches 14 (default)
    "editor.fontSize": 16,
    "editor.fontLigatures": false,
    "editor.cursorStyle": "line",

    // Terminal
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.fontSize": 16,

    // File / search behavior
    "files.watcherExclude": {
        ".git/objects/**": true,
        ".git/subtree-cache/**": true,
        ".hg/store/**": true,
        "*/.git/objects/**": true,
        "*/.git/subtree-cache/**": true,
        "*/.hg/store/**": true,
        "**/__pycache__/**": true,
        "**/*.py[cod]": true,
        "**/blib": true,
        "**/inc": true,
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/__pycache__/**": true,
        "**/*.py[cod]": true,
        "**/blib": true,
        "**/inc": true,
    },
    "files.associations": {
        "**/.bashrc": "shellscript",
        "**/.bash_aliases": "shellscript",
        "**/.inputrc": "properties",
        "**/.Xresources": "properties",
        "**/.Xresources.d/*": "properties",
        "config": "properties",
        "*.toml": "properties",
        "*.pod": "perl"
    },

    // Perl / LSP
    "perl-lsp.serverPath": "/home/johnm/.cargo/bin/perllsp",
    "perl-lsp.autoDownload": true,
    "perl-lsp.trace.server": "off",
    "perl-lsp.enableSemanticTokens": false,
    "perl-lsp.enableFormatting": true,
    "perl-lsp.formatOnSave": false,
    "perl-lsp.enableTestIntegration": true,
    "perl-lsp.perlcritic.enabled" : false,
    "perl-lsp.perlcritic.severity": 1,
    "perl-lsp.diagnostics": false,
    "perl-lsp.includePaths": [
        "lib",
        ".",
        "local/lib/perl5"
    ],
    "perl-lsp.perltidyConfig": "/home/johnm/.perltidyrc",
    "perl-lsp.autoPopulateNewFiles": true,
    "perl-lsp.featureProfile": "auto",    
    "[perl]": {
        //"editor.defaultFormatter": "EffortlessMetrics.perl-lsp-rs",
        //"editor.defaultFormatter": "richterger.perl"
        "editor.formatOnSave": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    // Perl / Perl::LanguageServer
    "perl.lsp.trace.server": "off",
    "perl.enable": false,
    "perl.showLocalVars": true,
    // "[perl]": {
    //     //"editor.defaultFormatter": "EffortlessMetrics.perl-lsp-rs",
    //     "editor.formatOnSave": false,
    //     "editor.tabSize": 4,
    //     "editor.insertSpaces": true,
    //     "editor.defaultFormatter": "richterger.perl"
    // },

    // powermode
    "powermode.enabled": false,
    "powermode.combo.location": "statusbar",
    "powermode.shake.enabled": false,

}