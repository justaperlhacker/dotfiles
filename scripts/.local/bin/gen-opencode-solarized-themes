#!/usr/bin/env python3
"""gen-opencode-solarized-themes - generate Solarized themes for OpenCode.

Writes these files into the OpenCode themes directory
(default ~/.config/opencode/themes):

  solarized-osaka-dark.json
  solarized-osaka-light.json
  solarized-high-contrast-dark.json
  solarized-high-contrast-light.json

Palette sources
---------------
* Solarized Osaka: craftzdog/solarized-osaka.nvim
  (lua/solarized-osaka/colors.lua). Text tokens follow the upstream
  Normal/NormalNC/Comment choices instead of the raw palette so Neovim and
  OpenCode match.

* Solarized high contrast: canonical Solarized values used by
  ishan9299/nvim-solarized-lua's `solarized-high` colorscheme. The Neovim and
  OpenCode sides intentionally share the same accent palette; only the
  semantic text/background roles differ.

The Neovim counterparts are upstream lazy.nvim plugins (see
nvim/.config/nvim/lua/plugins/colorscheme.lua), so there is nothing to
generate for Neovim here.

Usage
-----
  gen-opencode-solarized-themes           # regenerate the JSON files
  gen-opencode-solarized-themes --check   # validate and compare, write nothing
  gen-opencode-solarized-themes --out DIR # write somewhere else

Run it again after changing a palette in this file, or after pulling an upstream
Solarized update.
"""

import argparse
import copy
import json
import os
import re
import sys

SCHEMA = "https://opencode.ai/theme.json"
DEFAULT_OUT = "~/.config/opencode/themes"
CATEGORICAL = ["accent", "green", "yellow", "blue", "purple", "cyan", "orange", "red"]


# --------------------------------------------------------------------------
# Color helpers
# --------------------------------------------------------------------------


def hex_to_rgb(value):
    value = value.lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


def rgb_to_hex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c))) for c in rgb)


def mix(a, b, t):
    ra, rb = hex_to_rgb(a), hex_to_rgb(b)
    return rgb_to_hex([ra[i] + (rb[i] - ra[i]) * t for i in range(3)])


def scale(accent, dark=True):
    """Build a nine-step hue scale.

    Dark themes run bright (100) to dark (900). Light themes run dark (100) to
    bright (900), matching the direction used by OpenCode's built-in themes.
    """
    steps = [0.55, 0.35, 0.15, 0.05, 0.0, 0.12, 0.25, 0.45, 0.65]
    result = {}
    for index, step in enumerate(steps, start=1):
        if dark:
            color = mix(accent, "#ffffff", step) if step <= 0.55 else mix(accent, "#000000", step)
        else:
            color = mix(accent, "#000000", step) if step <= 0.55 else mix(accent, "#ffffff", step)
        result[str(index * 100)] = color
    return result


def invert(hue):
    return {str(i): hue[str(1000 - i)] for i in range(100, 1000, 100)}


