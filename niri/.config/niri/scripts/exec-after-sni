#!/bin/sh
# Wait for the shell/bar to export its StatusNotifierWatcher host, then exec the
# given command. Tray apps (Discord, Slack, Telegram, ...) fail to register their
# icon if launched before the watcher exists and never retry, so delay them.
#
# Usage: exec-after-sni <command> [args...]

if [ "$#" -eq 0 ]; then
    echo "usage: ${0##*/} <command> [args...]" >&2
    exit 2
fi

self=$0
[ -L "$self" ] && self=$(readlink -f "$self")
script_dir=$(unset CDPATH; cd -- "$(dirname -- "$self")" && pwd -P)

. "$script_dir/wait-lib.sh"

# 40 * 0.25s = 10s max wait. Start the app anyway on timeout: a missing tray
# icon is better than a missing app.
wait_for_prop org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
    org.kde.StatusNotifierWatcher IsStatusNotifierHostRegistered true 40 0.25

exec "$@"
