# --------------------------------------------------------------------------
# Theme builder
# --------------------------------------------------------------------------


def build_theme(palette):
    """Expand a palette role table into an OpenCode theme document."""
    text = {
        "base": palette["text"],
        "muted": palette["muted"],
        "faint": palette["faint"],
        "action": {
            "primary": {
                "base": palette["accent"],
                "$hovered": palette["accent_hover"],
                "$focused": palette["accent_focus"],
                "$pressed": palette["accent_press"],
                "$selected": palette["accent_select"],
                "$disabled": palette["disabled"],
            },
            "secondary": {
                "base": palette["secondary"],
                "$hovered": palette["secondary_hover"],
                "$focused": palette["secondary_focus"],
                "$pressed": palette["secondary_hover"],
                "$selected": palette["secondary_hover"],
                "$disabled": palette["disabled"],
            },
            "destructive": {
                "base": palette["destructive"],
                "$hovered": palette["destructive_hover"],
                "$focused": palette["destructive_focus"],
                "$pressed": palette["destructive_press"],
                "$selected": palette["destructive_select"],
                "$disabled": palette["disabled"],
            },
        },
        "formfield": {
            "base": palette["text"],
            "$hovered": palette["accent"],
            "$focused": palette["accent"],
            "$pressed": palette["accent"],
            "$selected": palette["accent"],
            "$disabled": palette["disabled"],
        },
        "feedback": {
            "error": {"base": palette["error"], "muted": palette["error_muted"]},
            "warning": {"base": palette["warning"], "muted": palette["warning_muted"]},
            "success": {"base": palette["success"], "muted": palette["success_muted"]},
            "info": {"base": palette["info"], "muted": palette["info_muted"]},
        },
    }

    background = {
        "base": palette["bg"],
        "raised": {
            "base": palette["raised"],
            "high": palette["raised_high"],
            "max": palette["raised_max"],
        },
        "action": {
            "primary": {
                "base": "transparent",
                "$hovered": palette["action_hover_bg"],
                "$focused": palette["accent"],
                "$pressed": palette["action_press_bg"],
                "$selected": palette["action_hover_bg"],
                "$disabled": "transparent",
            },
            "secondary": {
                "base": "transparent",
                "$hovered": palette["action_hover_bg"],
                "$focused": palette["action_hover_bg"],
                "$pressed": palette["action_press_bg"],
                "$selected": palette["action_hover_bg"],
                "$disabled": "transparent",
            },
            "destructive": {
                "base": palette["destructive_bg"],
                "$hovered": palette["destructive_bg_hover"],
                "$focused": palette["destructive"],
                "$pressed": palette["destructive_bg"],
                "$selected": palette["destructive_bg_hover"],
                "$disabled": "transparent",
            },
        },
        "formfield": {"base": palette["formfield_bg"]},
        "feedback": {
            "error": {"base": palette["error_bg"]},
            "warning": {"base": palette["warning_bg"]},
            "success": {"base": palette["success_bg"]},
            "info": {"base": palette["info_bg"]},
        },
    }

    base = {
        "categorical": list(CATEGORICAL),
        "text": text,
        "background": background,
        "border": {"base": palette["border"]},
        "scrollbar": {"base": palette["scrollbar"]},
        "diff": {
            "text": {
                "added": palette["diff_add_text"],
                "removed": palette["diff_del_text"],
                "context": palette["diff_context"],
                "hunkHeader": palette["diff_hunk"],
            },
            "background": {
                "added": palette["diff_add_bg"],
                "removed": palette["diff_del_bg"],
                "context": palette["diff_context_bg"],
            },
            "highlight": {
                "added": palette["diff_add_hl"],
                "removed": palette["diff_del_hl"],
            },
            "lineNumber": {
                "text": palette["line_nr"],
                "background": {
                    "added": palette["diff_add_bg"],
                    "removed": palette["diff_del_bg"],
                },
            },
        },
        "syntax": {
            "comment": palette["syntax_comment"],
            "keyword": palette["syntax_keyword"],
            "function": palette["syntax_function"],
            "variable": palette["syntax_variable"],
            "string": palette["syntax_string"],
            "number": palette["syntax_number"],
            "type": palette["syntax_type"],
            "operator": palette["syntax_operator"],
            "punctuation": palette["syntax_punctuation"],
        },
        "markdown": {
            "text": palette["text"],
            "heading": palette["md_heading"],
            "link": palette["md_link"],
            "linkText": palette["md_link_text"],
            "code": palette["md_code"],
            "blockQuote": palette["md_blockquote"],
            "emphasis": palette["md_emphasis"],
            "strong": palette["md_strong"],
            "horizontalRule": palette["md_rule"],
            "listItem": palette["md_list"],
            "listEnumeration": palette["md_list_enum"],
            "image": palette["md_image"],
            "imageText": palette["md_image_text"],
            "codeBlock": palette["md_code_block"],
        },
        "@dialog": {
            "background": {
                "base": palette["dialog_bg"],
                "action": {"primary": {"$hovered": palette["dialog_hover"]}},
            }
        },
    }

    mode = palette["mode"]
    return {"$schema": SCHEMA, "base": base, mode: {"hue": palette["hues"], **copy.deepcopy(base)}}


# --------------------------------------------------------------------------
# Validation
# --------------------------------------------------------------------------

HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
HUE_NAMES = ("gray", "red", "orange", "yellow", "green", "cyan", "blue", "purple")


def walk(node, path=""):
    if isinstance(node, dict):
        for key, value in node.items():
            yield from walk(value, f"{path}.{key}" if path else key)
    elif isinstance(node, list):
        for index, value in enumerate(node):
            yield from walk(value, f"{path}[{index}]")
    else:
        yield path, node


def validate(theme, name):
    mode = "dark" if "dark" in theme else "light"
    base = theme["base"]
    overrides = theme[mode]

    if sorted(base) != sorted(key for key in overrides if key != "hue"):
        raise ValueError(f"{name}: base and {mode} token trees differ")

    for hue in HUE_NAMES:
        steps = sorted(overrides["hue"][hue])
        if steps != [str(i) for i in range(100, 1000, 100)]:
            raise ValueError(f"{name}: hue {hue} does not have nine steps")

    aliases = {key: overrides["hue"].get(key) for key in ("accent", "interactive", "neutral")}
    if aliases != {"accent": "$hue.green", "interactive": "$hue.green", "neutral": "$hue.gray"}:
        raise ValueError(f"{name}: hue aliases are incorrect")

    def resolve(reference):
        node = overrides
        for part in reference[1:].split("."):
            node = node[part]
        return node

    for path, value in list(walk(base)) + list(walk({k: v for k, v in overrides.items() if k != "hue"})):
        if path.startswith("categorical"):
            continue
        if not isinstance(value, str):
            continue
        if value.startswith("$"):
            resolved = resolve(value)
            if not (isinstance(resolved, dict) or resolved.startswith("#")):
                raise ValueError(f"{name}:{path}: {value} resolved to {resolved!r}")
        elif value != "transparent" and not HEX_RE.match(value):
            raise ValueError(f"{name}:{path}: invalid color {value!r}")

    for hue in base["categorical"]:
        if hue not in overrides["hue"]:
            raise ValueError(f"{name}: categorical hue {hue} is undefined")


# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(description="Generate OpenCode Solarized themes.")
    parser.add_argument("--out", default=os.path.expanduser(DEFAULT_OUT),
                        help=f"output directory (default: {DEFAULT_OUT})")
    parser.add_argument("--check", action="store_true",
                        help="validate generated themes and compare with files on disk; write nothing")
    args = parser.parse_args()

    themes = {
        "solarized-osaka-dark": build_theme(osaka_dark_palette()),
        "solarized-osaka-light": build_theme(osaka_light_palette()),
        "solarized-high-contrast-dark": build_theme(high_contrast_dark_palette()),
        "solarized-high-contrast-light": build_theme(high_contrast_light_palette()),
    }

    if not args.check:
        os.makedirs(args.out, exist_ok=True)

    failures = 0
    for name, theme in themes.items():
        validate(theme, name)
        path = os.path.join(args.out, name + ".json")

        if args.check:
            if not os.path.exists(path):
                print(f"missing  {path}")
                failures += 1
                continue
            with open(path, encoding="utf-8") as handle:
                current = json.load(handle)
            if current != theme:
                print(f"outdated {path}")
                failures += 1
            else:
                print(f"ok       {path}")
            continue

        with open(path, "w", encoding="utf-8") as handle:
            json.dump(theme, handle, indent=2)
            handle.write("\n")
        print(f"wrote    {path}")

    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
