#!/usr/bin/env perl
# toggle-tmux (Hyprland port of the niri scratchpad helper).
# Toggles a floating, centered terminal window running a named tmux session.
use v5.36;
use Getopt::Long;
use Time::HiRes qw(sleep time);
use JSON::PP;

sub hypr {
    my $cmd = join " ", "hyprctl", @_;
    return `$cmd`;
}

sub hypr_json {
    my $cmd = join " ", "hyprctl", "-j", @_;
    return decode_json(`$cmd`);
}

sub get_clients { return hypr_json("clients"); }

sub is_target_window {
    my ( $w, $class, $title ) = @_;
    return 0 unless ( $w->{class} // '' ) eq $class;
    my $pid = $w->{pid} // 0;
    return 0 unless $pid;
    my $path = "/proc/$pid/cmdline";
    open my $fh, '<', $path or return 0;
    my $cmdline = do { local $/; <$fh> };
    close $fh;
    $cmdline =~ s/\0/ /g;
    return index( lc($cmdline), lc($title) ) >= 0;
}

sub find_target_window {
    my ( $clients, $class, $title ) = @_;
    for my $w ( $clients->@* ) {
        return $w if is_target_window( $w, $class, $title );
    }
    return undef;
}

sub is_kitty ($t) { return $t =~ m{(?:^|/)kitty$}; }

sub has_command ($name) {
    for my $dir ( split /:/, ( $ENV{PATH} // '' ) ) {
        next unless length $dir;
        return 1 if -x "$dir/$name";
    }
    return 0;
}

sub spawn_app {
    my ( $terminal, $session, $cmd ) = @_;
    my @args;
    if ( is_kitty($terminal) ) {
        @args = ( $terminal, '--instance-group', "tmux-$session", '--class', 'kitty', '-e', 'tmux', 'new-session', '-As', $session );
    }
    else {
        @args = ( $terminal, '-e', 'tmux', 'new-session', '-As', $session );
    }
    push @args, $cmd if defined $cmd;
    if ( fork == 0 ) {
        exec @args;
        die "exec failed: $!";
    }
}

sub focused_monitor_size {
    my $monitors = hypr_json("monitors");
    for my $m ( $monitors->@* ) {
        return ( $m->{width}, $m->{height} ) if $m->{focused};
    }
    my $m = $monitors->[0];
    return ( $m->{width}, $m->{height} );
}

sub float_and_center {
    my ( $addr, $width_pct ) = @_;
    my ( $mw, $mh ) = focused_monitor_size();
    my $w = int( $mw * $width_pct / 100 );
    my $h = int( $mh * 0.85 );
    hypr( "dispatch", "setfloating", "address:$addr" );
    sleep 0.05;
    hypr( "dispatch", "resizeactive", "exact $w $h" );
    hypr( "dispatch", "centerwindow" );
}

sub wait_for_window {
    my ( $class, $title, $timeout ) = @_;
    $timeout //= 3.0;
    my $deadline = time + $timeout;
    while ( time < $deadline ) {
        my $t = find_target_window( get_clients(), $class, $title );
        return $t if $t;
        sleep 0.2;
    }
    return undef;
}

my %opts;
GetOptions(
    \%opts,
    'terminal=s' => \my $terminal,
    'session=s',
    'cmd=s',
    'class=s' => \my $wclass,
    'title=s',
    'width=i',
) or die "Usage: $0 --session NAME --title TITLE [--cmd CMD] [--terminal kitty|konsole] [--class CLASS] [--width 75]\n";

$terminal //= has_command('kitty') ? 'kitty' : 'konsole';

my $session = $opts{session} // die "Error: --session is required\n";
my $cmd     = $opts{cmd};
$wclass //= is_kitty($terminal) ? 'kitty' : 'org.kde.konsole';
my $title = $opts{title} // die "Error: --title is required\n";
my $width = $opts{width} // 75;

my $clients    = get_clients();
my $target_win = find_target_window( $clients, $wclass, $title );

if ($target_win) {
    my $addr = $target_win->{address};
    if ( ( $target_win->{focusHistoryID} // 999 ) == 0 ) {
        hypr( "dispatch", "closewindow", "address:$addr" );
    }
    else {
        my $ws = hypr_json("activeworkspace")->{id};
        hypr( "dispatch", "movetoworkspacesilent", "$ws,address:$addr" );
        hypr( "dispatch", "focuswindow", "address:$addr" );
        float_and_center( $addr, $width );
    }
}
else {
    spawn_app( $terminal, $session, $cmd );
    $target_win = wait_for_window( $wclass, $title, 3.0 );
    if ($target_win) {
        my $addr = $target_win->{address};
        hypr( "dispatch", "focuswindow", "address:$addr" );
        float_and_center( $addr, $width );
    }
    else {
        print STDERR "Failed to find window for " . ( $cmd // $session ) . "\n";
        exit 1;
    }
}
