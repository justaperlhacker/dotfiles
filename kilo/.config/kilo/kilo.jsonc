      "pacman *": "allow",
      "mkdir *": "allow",
      "cmake .. *": "allow",
      "make *": "allow",
      "lua *": "allow",
      "luac *": "allow",
      "dpkg *": "allow",
      "true *": "allow",
      "nm *": "allow",
      "ldconfig *": "allow",
      "objdump *": "allow",
      "rm *": "allow",
      "/home/johnm/Repos/Tools/lsyncd/build/lsyncd *": "allow",
      "xxd *": "allow",
      "awk *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git add *": "allow",
      "git remote -v *": "allow",
      "git commit *": "allow",
