[Unit]
Description=Toggle tmux scratchpad: %i

[Service]
Type=oneshot
# The helper forks the terminal; do not let systemd reap it when we exit.
KillMode=process
ExecStart=%h/.local/bin/plasma-toggle-tmux --session %i

# Deliberately no [Install] section. This is a toggle *action*, started on
# demand by the KWin shortcut script via systemd1.Manager.StartUnit. Enabling
# it would run the toggle once at every login (and fail, since nothing is open
# yet). Do not add WantedBy=default.target back.
