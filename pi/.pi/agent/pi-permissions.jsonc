{
    "defaultPolicy": {
        "tools": "ask",
        "bash": "ask",
        "mcp": "ask",
        "skills": "ask",
        "special": "ask"
    },
    "tools": {
        "read": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow",
        "write": "ask",
        "edit": "ask"
    },
    "skills": {
        // Silent skill loads/reads. The `ask` default here only produced
        // prompts during normal skill use (user-invoked /skill:<name> already
        // bypassed it). Tighten with specific patterns, e.g. "dangerous-*": "deny".
        "*": "allow"
    },
    "bash": {
        // Broad fallback. PLAN mode read-only enforcement is handled by the
        // plan-build extension (hard-blocks mutating commands there), so bash
        // is left open in BUILD mode to avoid per-command approvals.
        // Flip back to "ask" to re-arm the allowlist below.
        "*": "allow",

        // Redundant while "*" is "allow" (last matching rule wins, "*" wins
        // first). Kept so reverting the line above restores the allowlist.

        // File inspection
        "cat *": "allow",
        "head *": "allow",
        "tail *": "allow",
        "less *": "allow",
        "more *": "allow",

        // Listing and metadata
        "ls *": "allow",
        "tree *": "allow",
        "stat *": "allow",
        "file *": "allow",
        "wc *": "allow",
        "du *": "allow",
        "df *": "allow",

        // Search (find/fd with -exec are auto-floored to ask)
        "grep *": "allow",
        "egrep *": "allow",
        "fgrep *": "allow",
        "rg *": "allow",
        "find *": "allow",
        "fd *": "allow",

        // Comparison and hashing
        "diff *": "allow",
        "cmp *": "allow",
        "comm *": "allow",
        "md5sum *": "allow",
        "sha1sum *": "allow",
        "sha256sum *": "allow",
        "cksum *": "allow",

        // System info
        "pwd": "allow",
        "whoami": "allow",
        "id": "allow",
        "hostname": "allow",
        "uname *": "allow",
        "date": "allow",
        "uptime": "allow",
        "ps *": "allow",
        "printenv *": "allow",
        "which *": "allow",
        "type *": "allow",

        // Git read-only subcommands
        "git status *": "allow",
        "git diff *": "allow",
        "git log *": "allow",
        "git show *": "allow",
        "git blame *": "allow",
        "git ls-files *": "allow",
        "git branch": "allow",
        "git remote -v": "allow"
    }
}
