[Desktop Entry]
Type=Application
Name=kilo Scratchpad
GenericName=Text editor scratchpad
Comment=Toggle the kilo tmux scratchpad (SUPER+SHIFT+F9)
Exec=/usr/bin/systemctl --user start plasma-toggle-tmux@kilo.service
Icon=kitty
Terminal=false
StartupNotify=false
StartupWMClass=tmux-kilo
Categories=Utility;TextEditor;
Keywords=kilo;tmux;scratchpad;terminal;
