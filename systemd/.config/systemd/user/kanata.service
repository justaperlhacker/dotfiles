[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:%h/.cargo/bin:%h/.local/bin
Environment=DISPLAY=:0
Type=simple
ExecStart=
ExecStart=/usr/bin/kanata --cfg %h/.config/kanata/config.kbd --wait-device-ms 1000
#ExecStart=/usr/bin/sh -c 'exec $$(which kanata) --cfg $${HOME}/.config/kanata/config.kbd'
Restart=no

[Install]
WantedBy=default.target
