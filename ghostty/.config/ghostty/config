# Ghostty configuration
# See https://ghostty.org/docs/config/reference

# Color scheme from the Gogh "Tokyo Night Terminal Dark" palette
# (stowed theme file; also stowed: dankcolors from DankMaterialShell).
theme = TokyoNight Terminal Dark

# Font
font-family = JetBrainsMono Nerd Font

# Cursor animations ("trails"): a GPU shader that animates the cursor's
# movement between frames. Comment/uncomment to switch styles, or point at
# any other .glsl in ~/.config/ghostty/shaders/. Changes reload live.
custom-shader = shaders/cursor_blaze.glsl
# custom-shader = shaders/smear_cursor_blocks.glsl

# With a trail active, animate unfocused windows too (default: focused only).
# custom-shader-animation = always

# Behaviour basics:
mouse-hide-while-typing = true
