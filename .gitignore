.backup/

.config/bash/local
.vscode

# DankMaterialShell transpient files
DankMaterialShell/.config/DankMaterialShell/.changelog-*
DankMaterialShell/.config/DankMaterialShell/.firstlaunch
DankMaterialShell/.config/DankMaterialShell/firefox.css
DankMaterialShell/.config/DankMaterialShell/plugins/

# user enablement state (managed locally by `systemctl --user enable`,
# ignored by stow via .stow-local-ignore) — never commit.
kanata/.config/systemd/user/*.wants/

# ignore nvim pack repos (nvim plugins) — managed manually
nvim/.config/nvim/pack/

# LazyVim — machine-specific / starter template files
LazyVim/.config/LazyVim/.neoconf.json
LazyVim/.config/LazyVim/.gitignore
LazyVim/.config/LazyVim/lua/plugins/example.lua
LazyVim/.config/LazyVim/tt.*
LazyVim/.config/LazyVim/.tests
LazyVim/.config/LazyVim/doc/tags
LazyVim/.config/LazyVim/debug
LazyVim/.config/LazyVim/.repro
LazyVim/.config/LazyVim/foo.*
LazyVim/.config/LazyVim/*.log
LazyVim/.config/LazyVim/data



# Python bytecode (i3-multimonitor.py, i3-workspace-buttons.py)
i3/.config/i3/scripts/__pycache__/

# fontconfig cache UUIDs (generated by fc-cache)
fonts/.fonts/*/.uuid

# Midnight Commander runtime state (rewritten each session) — never commit
#mc/.config/mc/ini
#mc/.config/mc/panels.ini
# trayxeyes compiled binaries (built via make)
i3/.config/i3/scripts/trayxeyes
i3/.config/i3/trayxeyes/trayxeyes
