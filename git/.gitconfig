[include]
	path = ~/.gituserconfig
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[help]
	autocorrect = 10
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = zebra
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
[alias]
	st = status -sb
	co = checkout
	br = branch -vv
	lg = log --oneline --graph --decorate
	last = log -1 HEAD --stat
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
