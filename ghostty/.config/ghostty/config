# Ghostty configuration
# See https://ghostty.org/docs/config/reference

theme = TokyoNight Terminal Dark

# Font
font-family = JetBrainsMono Nerd Font

# Cursor animation: hybrid Konsole (typing) + kitty (large jumps).
# Style is auto-detected: block, bar, or underline.
# Alternatives:
#   custom-shader = shaders/cursor_morph-konsole.glsl
#   custom-shader = shaders/cursor_trail-kitty.glsl
#   custom-shader = shaders/cursor_smear_fade-kittymatch.glsl
cursor-style = bar
custom-shader = shaders/cursor_hybrid-konsole-kitty.glsl

# Behaviour basics:
#mouse-hide-while-typing = true

# keep the shell prompt from overriding the cursor style
#shell-integration-features = no-cursor
