#!/usr/bin/env python3
"""ocs - browse and resume OpenCode sessions across every project.

OpenCode scopes /sessions and `opencode session list` to the directory you
launch it from. ocs reads the local OpenCode database directly, so it can show
every top-level session, grouped by directory, and resume the one you pick in
its original directory.

  ocs                     fzf picker over every session, grouped by folder
  ocs rust                picker pre-filled with "rust"
  ocs -l                  plain list (no picker)
  ocs --ids               print session IDs only (for scripts)
  ocs --json              print the full session list as JSON
  ocs --show ses_abc123   details for one session
  ocs -a                  include archived sessions
  ocs -d ~/Projects       only sessions from that directory and below
  ocs -n 20               show at most 20 sessions
  ocs --dry-run           print the resume command instead of running it

Selected sessions resume with `opencode -s <id>` from their recorded directory.
That matters: resuming from the wrong directory can 404 or create a shadow
session with the same ID (opencode issue #61947).

Reads session_v2 from the local database (OPENCODE_DB is respected). Uses fzf
when available and falls back to a numbered prompt.
"""

import argparse
import json
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import time
import zlib
from pathlib import Path
from urllib.parse import quote

HOME = Path.home()

# One colour per project directory so groups are visually distinct.
DIR_COLORS = ("36", "35", "33", "96", "95", "94", "92", "93")
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")

SESSION_COLUMNS = """
    id, directory, title, time_updated, time_created,
    COALESCE(time_archived, 0), COALESCE(agent, ''),
    COALESCE(model, ''), project_id
"""


def fail(message, code=1):
    print(f"ocs: {message}", file=sys.stderr)
    raise SystemExit(code)


def data_home():
    return Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "opencode"


def resolve_db(override):
    """Return the database path the way the opencode CLI resolves it."""
    if override:
        return Path(override).expanduser()

    env = os.environ.get("OPENCODE_DB")
    if env:
        if env == ":memory:":
            fail("OPENCODE_DB=:memory: cannot be read from another process")
        path = Path(env).expanduser()
        # OpenCode resolves relative overrides under its data directory.
        return path if path.is_absolute() else data_home() / path

    # Let the CLI decide: this respects the release channel and any overrides.
    try:
        result = subprocess.run(
            ["opencode", "debug", "paths", "db"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        path = result.stdout.strip()
        if result.returncode == 0 and path:
            return Path(path)
    except (OSError, subprocess.TimeoutExpired):
        pass

    return data_home() / "opencode.db"


def connect(path):
    if not path.is_file():
        fail(
            f"OpenCode database not found: {path}\n"
            "  Set OPENCODE_DB or pass --db if it lives elsewhere."
        )
    try:
        con = sqlite3.connect(f"file:{quote(str(path), safe='/')}?mode=ro", uri=True)
        con.execute("SELECT 1 FROM session_v2 LIMIT 1")
    except sqlite3.Error as exc:
        fail(f"cannot read {path}: {exc}")
    return con


def load_sessions(con):
    rows = []
    sql = f"SELECT {SESSION_COLUMNS} FROM session_v2 WHERE parent_id IS NULL"
    for row in con.execute(sql):
        rows.append(
            {
                "id": row[0],
                "directory": row[1],
                "title": row[2] or "(untitled)",
                "updated": row[3],
                "created": row[4],
                "archived": bool(row[5]),
                "agent": row[6],
                "model": format_model(row[7]),
                "project": row[8],
            }
        )
    exists = {}
    for row in rows:
        directory = row["directory"]
        if directory not in exists:
            exists[directory] = Path(directory).is_dir()
        row["folder_missing"] = not exists[directory]
    return rows


def format_model(raw):
    if not raw:
        return ""
    try:
        model = json.loads(raw)
    except json.JSONDecodeError:
        return raw
    if isinstance(model, dict):
        provider = model.get("providerID") or model.get("provider") or ""
        name = model.get("id") or model.get("modelID") or ""
        return f"{provider}/{name}" if provider else name
    return str(model)


def short_dir(directory):
    text = str(directory)
    if text == str(HOME):
        return "~"
    prefix = str(HOME) + os.sep
    if text.startswith(prefix):
        return "~/" + text[len(prefix) :]
    return text


def colorize(code, text, enabled):
    return f"\x1b[{code}m{text}\x1b[0m" if enabled else text


def dir_color(directory):
    return DIR_COLORS[zlib.crc32(str(directory).encode()) % len(DIR_COLORS)]


def ago(milliseconds):
    if not milliseconds:
        return "-"
    seconds = max(0, time.time() - milliseconds / 1000)
    if seconds < 60:
        return f"{int(seconds)}s"
    minutes = seconds / 60
    if minutes < 60:
        return f"{int(minutes)}m"
    hours = minutes / 60
    if hours < 24:
        return f"{int(hours)}h"
    days = hours / 24
    if days < 7:
        return f"{int(days)}d"
    if days < 30:
        return f"{int(days / 7)}w"
    if days < 365:
        return f"{int(days / 30)}mo"
    return f"{days / 365:.1f}y"


def iso(milliseconds):
    if not milliseconds:
        return "-"
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(milliseconds / 1000))


def clean(text):
    return str(text).replace("\t", " ").replace("\r", " ").replace("\n", " ")


def matches(row, query):
    haystack = " ".join(
        (row["directory"], row["title"], row["id"], row["agent"], row["model"])
    ).lower()
    return all(term in haystack for term in query.lower().split())


def filter_rows(rows, args):
    if not args.archived:
        rows = [row for row in rows if not row["archived"]]
    if args.directory:
        base = os.path.normpath(str(Path(args.directory).expanduser()))
        rows = [
            row
            for row in rows
            if row["directory"] == base
            or row["directory"].startswith(base.rstrip(os.sep) + os.sep)
        ]
    rows.sort(key=lambda row: row["updated"], reverse=True)
    if args.limit is not None:
        rows = rows[: args.limit]
    return rows


def grouped(rows):
    """Group by directory; most recently used project first."""
    groups = {}
    for row in rows:
        groups.setdefault(row["directory"], []).append(row)
    ordered = []
    for _, members in sorted(
        groups.items(), key=lambda item: max(row["updated"] for row in item[1]), reverse=True
    ):
        ordered.extend(sorted(members, key=lambda row: row["updated"], reverse=True))
    return ordered


def list_line(row, use_color):
    title = clean(row["title"])
    if row["archived"]:
        title += "  [archived]"
    if row["folder_missing"]:
        title += "  [folder missing]"
    return "\t".join(
        (
            colorize(dir_color(row["directory"]), short_dir(row["directory"]), use_color),
            colorize("2", ago(row["updated"]), use_color),
            title,
            row["id"],
            row["directory"],
        )
    )


def print_list(rows):
    if not rows:
        print("No sessions found.")
        return
    use_color = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
    width = shutil.get_terminal_size((100, 24)).columns

    current = None
    for row in grouped(rows):
        if row["directory"] != current:
            current = row["directory"]
            if use_color:
                print()
            print(colorize(dir_color(current), short_dir(current), use_color))
        age = ago(row["updated"])
        title = clean(row["title"])
        if row["archived"]:
            title += "  [archived]"
        if row["folder_missing"]:
            title += "  [folder missing]"
        id_width = len(row["id"])
        title_width = max(20, width - 2 - 4 - 2 - id_width - 2)
        if len(title) > title_width:
            title = title[: title_width - 1] + "…"
        print(f"  {age:>4}  {title:<{title_width}}  {row['id']}")


def print_json(rows):
    data = []
    for row in rows:
        data.append(
            {
                "id": row["id"],
                "directory": row["directory"],
                "title": row["title"],
                "updated": iso(row["updated"]),
                "created": iso(row["created"]),
                "archived": row["archived"],
                "agent": row["agent"],
                "model": row["model"],
                "projectID": row["project"],
                "folderMissing": row["folder_missing"],
            }
        )
    print(json.dumps(data, indent=2))


def last_user_prompt(con, session_id):
    row = con.execute(
        "SELECT data FROM session_message "
        "WHERE session_id = ? AND type = 'user' ORDER BY seq DESC LIMIT 1",
        (session_id,),
    ).fetchone()
    if not row:
        return ""
    try:
        data = json.loads(row[0])
    except (TypeError, json.JSONDecodeError):
        return ""
    text = data.get("text") or ""
    if not text and isinstance(data.get("content"), str):
        text = data["content"]
    return text.strip()


def show_session(con, session_id):
    row = con.execute(
        f"SELECT {SESSION_COLUMNS} FROM session_v2 WHERE id = ?", (session_id,)
    ).fetchone()
    if not row:
        fail(f"session not found: {session_id}")

    messages = con.execute(
        "SELECT COUNT(*) FROM session_message WHERE session_id = ?", (session_id,)
    ).fetchone()[0]
    prompt = last_user_prompt(con, session_id)

    use_color = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
    directory = row[1]
    folder_state = "ok" if Path(directory).is_dir() else "missing"

    def field(label, value):
        print(f"{colorize('1', f'{label:<10}', use_color)} {value}")

    field("Title", row[2] or "(untitled)")
    field("Directory", f"{directory}  ({folder_state})")
    field("Session", row[0])
    field("Updated", f"{iso(row[3])} ({ago(row[3])} ago)")
    field("Created", iso(row[4]))
    field("Project", row[8])
    field("Agent", row[6] or "-")
    field("Model", format_model(row[7]) or "-")
    field("Messages", messages)
    field("Archived", "yes" if row[5] else "no")
    if prompt:
        text = ANSI_RE.sub("", prompt)
        lines = text.splitlines()
        print()
        print(colorize("1", "Last prompt", use_color))
        for line in lines[:12]:
            print(f"  {line[:200]}")
        if len(lines) > 12 or len(text) > 200 * 12:
            print("  …")


def fzf_pick(rows, query, db):
    if shutil.which("fzf") is None:
        return numbered_pick(rows)

    script = Path(__file__).resolve()
    preview = (
        f"{shlex.quote(sys.executable)} {shlex.quote(str(script))}"
        f" --show {{4}} --db {shlex.quote(str(db))}"
    )
    command = [
        "fzf",
        "--ansi",
        "--delimiter=\t",
        "--with-nth=1,2,3",
        "--nth=1,3",
        "--reverse",
        "--height=~90%",
        "--border=rounded",
        "--info=inline-right",
        "--prompt=opencode ❯ ",
        f"--header=Enter resume · Ctrl-/ preview · {len(rows)} sessions",
        "--preview",
        preview,
        "--preview-window=right,55%,wrap",
        "--bind=ctrl-/:toggle-preview",
    ]
    if query:
        command += ["--query", query]

    lines = [list_line(row, os.environ.get("NO_COLOR") is None) for row in rows]
    result = subprocess.run(
        command,
        input="\n".join(lines) + "\n",
        text=True,
        stdout=subprocess.PIPE,
    )
    if result.returncode in (1, 130):
        return None
    if result.returncode != 0:
        fail(f"fzf failed with exit code {result.returncode}", 2)
    if not result.stdout.strip():
        return None

    # Interactive fzf prints one line. --filter mode (handy for testing and
    # scripting) prints every match, so always take the first one.
    fields = result.stdout.splitlines()[0].split("\t")
    if len(fields) < 5:
        fail("unexpected output from fzf", 2)
    return {"id": fields[3], "directory": fields[4]}


def numbered_pick(rows):
    for number, row in enumerate(rows, 1):
        title = clean(row["title"])
        if row["archived"]:
            title += "  [archived]"
        if row["folder_missing"]:
            title += "  [folder missing]"
        print(f"{number:3}  {ago(row['updated']):>4}  {short_dir(row['directory'])}  {title}")
    try:
        choice = input("\nSession number (blank to cancel): ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if not choice:
        return None
    try:
        row = rows[int(choice) - 1]
    except (ValueError, IndexError):
        fail("invalid selection")
    return {"id": row["id"], "directory": row["directory"]}


def resume(selection, dry_run):
    session_id = selection["id"]
    directory = selection["directory"]

    if not Path(directory).is_dir():
        fail(
            f"session directory no longer exists: {directory}\n"
            f"  Inspect it with: ocs --show {session_id}"
        )

    if dry_run:
        print(f"cd {shlex.quote(directory)} && opencode -s {shlex.quote(session_id)}")
        return

    os.chdir(directory)
    try:
        os.execvp("opencode", ["opencode", "-s", session_id])
    except FileNotFoundError:
        fail("opencode not found on PATH")


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ocs",
        description="Browse and resume OpenCode sessions across every project.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Selected sessions resume with `opencode -s <id>` from their recorded\n"
            "directory. Use --dry-run to see the command."
        ),
    )
    parser.add_argument("query", nargs="?", help="initial fzf query")
    parser.add_argument("-l", "--list", action="store_true", help="print a list")
    parser.add_argument("--ids", action="store_true", help="print session IDs only")
    parser.add_argument("--json", action="store_true", help="print sessions as JSON")
    parser.add_argument("--show", metavar="ID", help="show details for one session")
    parser.add_argument(
        "-a", "--archived", action="store_true", help="include archived sessions"
    )
    parser.add_argument(
        "-d",
        "--directory",
        metavar="PATH",
        help="only sessions in PATH or below",
    )
    parser.add_argument(
        "-n", "--limit", type=int, metavar="N", help="show at most N sessions"
    )
    parser.add_argument("--db", metavar="PATH", help="database path override")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the resume command instead of running it",
    )
    return parser


def main():
    args = build_parser().parse_args()
    db = resolve_db(args.db)
    con = connect(db)

    if args.show:
        show_session(con, args.show)
        return

    rows = filter_rows(load_sessions(con), args)
    if args.query and (args.list or args.ids or args.json):
        rows = [row for row in rows if matches(row, args.query)]

    if args.json:
        print_json(rows)
        return
    if args.ids:
        for row in rows:
            print(row["id"])
        return
    if args.list:
        print_list(rows)
        return
    if not rows:
        fail("no sessions found", 1)

    selection = fzf_pick(rows, args.query, db)
    if selection is None:
        return
    resume(selection, args.dry_run)


if __name__ == "__main__":
    main()
