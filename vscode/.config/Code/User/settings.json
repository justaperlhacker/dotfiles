{
    // General / UI
    // disable all telemetry / online experiments / update checks
    "update.mode": "none",
    "telemetry.telemetryLevel": "off",
    "telemetry.feedback.enabled": false,
    "telemetry.editStats.enabled": false,
    "telemetry.sendUsageData": false,
    "telemetry.crashReporter.enabled": false,
    "redhat.telemetry.enabled": false,
    "dotnet.telemetry.optout": true,
    "powershell.telemetry.enabled": false,
    "workbench.enableExperiments": false,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",
    "npm.fetchOnlinePackageInfo": false,
    "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
    "extensions.ignoreRecommendations": true,
    "workbench.list.openMode": "doubleClick",
    "workbench.iconTheme": "file-icons-colourless",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.activityBar.location": "top",
    "git.enabled": false,
    "makefile.configureOnOpen": true,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "github.copilot.enable": {
        "*": false
    },
    // Inline code completion comes from the FIM server on the AMD card
    // (llama-completion.service, port 8082) via the ggml-org llama-vscode
    // extension. It POSTs to /infill with input_prefix/input_suffix, which is
    // llama.cpp's native FIM path; the Qwen 2.5 Coder model handles the
    // <|fim_prefix|>/<|fim_suffix|>/<|fim_middle|> markers itself.
    // Server is loopback-only and has no API key. Chat/agents in VS Code come
    // from the OpenCode and Pi ("Pendant") extensions, which read their own
    // configs and already list qwen38.
    "llama-vscode.enabled": true,
    "llama-vscode.endpoint": "http://127.0.0.1:8082",
    "llama-vscode.ask_install_llamacpp": false,
    "llama-vscode.auto": true,
    "llama-vscode.debounce_ms": 150,
    "llama-vscode.n_predict": 128,
    // The FIM server runs with -np 1 (a single slot), so the extension must ask
    // for exactly one completion. Its default of 3 makes llama.cpp return
    // HTTP 400: "Field 'n_cmpl': Value must be between 1 <= value <= 1".
    "llama-vscode.max_parallel_completions": 1,
    // Make the systemd-managed server selectable by name in the completion menu
    // instead of only through "Use settings". An empty localStartCommand means
    // selecting it just switches the endpoint to 8082; it does not spawn
    // another llama-server (that stays owned by llama-completion.service).
    "llama-vscode.completion_models_list": [
        {
            "name": "llama-completion (systemd, 8082)",
            "endpoint": "http://127.0.0.1:8082",
            "localStartCommand": ""
        }
    ],
    "vim.handleKeys": {
        "<C-b>": false,
        "<C-j>": false,
        "<C-l>": false,
    },
    // zoom level
    //"window.zoomLevel": -1,

    // trusted domains
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },

