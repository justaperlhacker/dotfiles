// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1793461452944849976 @name=brave-browser
window-rule {
    match app-id="^brave-browser$"
    open-maximized true
}

// @id=wr_1793461509009771109 @name=discord
window-rule {
    match app-id="^discord$"
    open-maximized true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
